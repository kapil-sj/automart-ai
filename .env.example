# AutoMart AI - Environment Variables Example
# Copy this file to .env.local and populate with your credentials.
# Do NOT commit real credentials or secret keys to version control.

# Supabase Public Configuration (Accessible in browser & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Required for server-side order creation, ledger entries, and backend operations.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
